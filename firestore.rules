rules_version = '2';
// NRボックス ラック調整 と スクラップ搬出 調整 のセキュリティルール
// 管理者のメールアドレスは、下の adminEmails() と index.html の NR_CONFIG.adminEmails の両方に書きます。
service cloud.firestore {
  match /databases/{database}/documents {
    function adminEmails() { return ['kowa0371@gmail.com', '030809240222im@gmail.com']; }

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in adminEmails();
    }
    function isSelf(id) { return signedIn() && request.auth.uid == id; }
    function isApproved() {
      return signedIn() && exists(/databases/$(database)/documents/approved/$(request.auth.uid));
    }
    function isApprovedScrap() {
      return signedIn() && exists(/databases/$(database)/documents/scrap_approved/$(request.auth.uid));
    }

    // 回収日・確定した回収・設定: 管理者と利用中の業者が読む。書けるのは管理者だけ
    match /config/{id} {
      allow read: if isAdmin() || isApproved();
      allow write: if isAdmin();
    }
    match /days/{id} {
      allow read: if isAdmin() || isApproved();
      allow write: if isAdmin();
    }
    match /confirmed/{id} {
      allow read: if isAdmin() || isApproved();
      allow write: if isAdmin();
    }

    // 業者の入力: 本人(利用中)と管理者だけ
    match /vendors/{id} {
      allow read: if isAdmin() || isSelf(id);
      allow write: if isAdmin() || (isSelf(id) && isApproved());
    }

    // 業者の登録内容: 本人が出し、管理者が見る
    match /members/{id} {
      allow read: if isAdmin() || isSelf(id);
      allow delete: if isAdmin();
      allow create, update: if isAdmin() || (isSelf(id)
        && request.resource.data.keys().hasOnly(['company', 'contact', 'email', 'at'])
        && request.resource.data.company is string && request.resource.data.company.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200);
    }

    // 利用許可: 業者は登録と同時に自分の分を作れる(利用停止された人は作れない)。変更・削除は管理者だけ
    match /approved/{id} {
      allow read: if isAdmin() || isSelf(id);
      allow create: if isAdmin() || (isSelf(id)
        && !exists(/databases/$(database)/documents/blocked/$(id))
        && request.resource.data.keys().hasOnly(['company', 'email', 'at'])
        && request.resource.data.company is string && request.resource.data.company.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200);
      allow update, delete: if isAdmin();
    }
    // 利用停止: 管理者だけが付け外しできる
    match /blocked/{id} {
      allow read: if isAdmin() || isSelf(id);
      allow write: if isAdmin();
    }
    // 管理者が追加したNRボックスの記録: 本人は読むだけ
    match /plans/{id} {
      allow read: if isAdmin() || isSelf(id);
      allow write: if isAdmin();
    }

    // ===== スクラップ搬出アプリ(scrap_ で始まるコレクション)。中身はNRボックスと同じ =====
    // 回収日・確定した回収・設定: 管理者と利用中の業者が読む。書けるのは管理者だけ
    match /scrap_config/{id} {
      allow read: if isAdmin() || isApprovedScrap();
      allow write: if isAdmin();
    }
    match /scrap_days/{id} {
      allow read: if isAdmin() || isApprovedScrap();
      allow write: if isAdmin();
    }
    match /scrap_confirmed/{id} {
      allow read: if isAdmin() || isApprovedScrap();
      allow write: if isAdmin();
    }

    // 業者の入力: 本人(利用中)と管理者だけ
    match /scrap_vendors/{id} {
      allow read: if isAdmin() || isSelf(id);
      allow write: if isAdmin() || (isSelf(id) && isApprovedScrap());
    }

    // 業者の登録内容: 本人が出し、管理者が見る
    match /scrap_members/{id} {
      allow read: if isAdmin() || isSelf(id);
      allow delete: if isAdmin();
      allow create, update: if isAdmin() || (isSelf(id)
        && request.resource.data.keys().hasOnly(['company', 'contact', 'email', 'at'])
        && request.resource.data.company is string && request.resource.data.company.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200);
    }

    // 利用許可: 業者は登録と同時に自分の分を作れる(利用停止された人は作れない)。変更・削除は管理者だけ
    match /scrap_approved/{id} {
      allow read: if isAdmin() || isSelf(id);
      allow create: if isAdmin() || (isSelf(id)
        && !exists(/databases/$(database)/documents/scrap_blocked/$(id))
        && request.resource.data.keys().hasOnly(['company', 'email', 'at'])
        && request.resource.data.company is string && request.resource.data.company.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200);
      allow update, delete: if isAdmin();
    }
    // 利用停止: 管理者だけが付け外しできる
    match /scrap_blocked/{id} {
      allow read: if isAdmin() || isSelf(id);
      allow write: if isAdmin();
    }
    // 管理者が追加したNRボックスの記録: 本人は読むだけ
    match /scrap_plans/{id} {
      allow read: if isAdmin() || isSelf(id);
      allow write: if isAdmin();
    }
  }
}
