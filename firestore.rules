rules_version = '2';
// NRボックス ラック調整 と スクラップ搬出 調整 のセキュリティルール
// このファイルは tools/make-rules.py で作っています。直すときはスクリプトを直して作り直してください。
service cloud.firestore {
  match /databases/{database}/documents {
    function adminEmails() { return ['kowa0371@gmail.com', '030809240222im@gmail.com', 'aiko.h@shimz.co.jp', 't.hiramatsu@shimz.co.jp', 'janki.onimatu@gmail.com', 'n.katou@shimz.co.jp', 'a.takada@shimz.co.jp', 'a-nagashima@shimz.co.jp']; }

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in adminEmails();
    }
    function isSelf(id) { return signedIn() && request.auth.uid == id; }

    // ===== NRボックス =====
    function isApproved() {
      return signedIn() && exists(/databases/$(database)/documents/approved/$(request.auth.uid));
    }
    // 会社のメンバー: 会社IDが本人のID(最初に登録した人)か、利用許可(approved)に入っている会社ID(vid)と同じ
    function isMember(id) {
      return signedIn() && (request.auth.uid == id
        || (exists(/databases/$(database)/documents/approved/$(request.auth.uid))
            && get(/databases/$(database)/documents/approved/$(request.auth.uid)).data.get('vid', request.auth.uid) == id));
    }
    // 揚重(盛替え)業者: 申請して利用許可(crews)がある人。搬出予定を見て、搬出確認と戻しの✅だけ付けられる
    function isCrew() {
      return signedIn() && exists(/databases/$(database)/documents/crews/$(request.auth.uid));
    }

    // 回収日・設定: 管理者・利用中の業者・盛替え業者が読む。書けるのは管理者だけ
    match /config/{id} {
      allow read: if isAdmin() || isApproved() || isCrew();
      allow write: if isAdmin();
    }
    match /days/{id} {
      allow read: if isAdmin() || isApproved() || isCrew();
      allow write: if isAdmin();
    }
    // 確定した回収: 行(rows)は管理者だけ。盛替え業者は行ごとの搬出確認・戻し(st)と履歴(hist)だけ書き換えられる
    match /confirmed/{id} {
      allow read: if isAdmin() || isApproved() || isCrew();
      allow write: if isAdmin();
      allow update: if isCrew() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'at', 'hist']);
    }

    // 業者の入力: 本人(利用中)と管理者。盛替え業者は戻したときの台数(floors)だけ書き換えられる
    match /vendors/{id} {
      allow read: if isAdmin() || isMember(id) || isCrew();
      allow write: if isAdmin() || (isMember(id) && isApproved());
      allow update: if isCrew() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['floors', 'updated']);
    }

    // 業者の登録内容: 本人が出し、管理者が見る
    match /members/{id} {
      allow read: if isAdmin() || isSelf(id);
      allow delete: if isAdmin();
      allow create, update: if isAdmin() || (isSelf(id)
        && request.resource.data.keys().hasOnly(['company', 'contact', 'email', 'at'])
        && request.resource.data.company is string && request.resource.data.company.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200);
    }

    // 利用許可: 業者は登録と同時に自分の分を作れる(利用停止された人は作れない)。変更・削除は管理者だけ(本人は参加コードでの会社の入り直しだけできる)
    // 会社ID(vid)は、新しい会社なら本人のID、参加コードで入るならそのコードの会社ID
    match /approved/{id} {
      allow read: if isAdmin() || isSelf(id);
      allow create: if isAdmin() || (isSelf(id)
        && !exists(/databases/$(database)/documents/blocked/$(id))
        && request.resource.data.keys().hasOnly(['company', 'email', 'at', 'vid', 'code', 'name'])
        && (request.resource.data.get('vid', id) == id
            || (request.resource.data.code is string
                && get(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.vid == request.resource.data.vid))
        && request.resource.data.company is string && request.resource.data.company.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200);
      allow update, delete: if isAdmin();
      // 登録した後でも、参加コードで別の会社に入り直せる(会社ID・コード・会社名だけ。コードの会社IDと一致するときだけ)
      allow update: if isSelf(id)
        && !exists(/databases/$(database)/documents/blocked/$(id))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vid', 'code', 'company'])
        && request.resource.data.code is string
        && get(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.vid == request.resource.data.vid
        && request.resource.data.company is string && request.resource.data.company.size() <= 100;
    }
    // 利用停止: 管理者だけが付け外しできる
    match /blocked/{id} {
      allow read: if isAdmin() || isSelf(id);
      allow write: if isAdmin();
    }
    // 追加した台数の記録: 会社のメンバーは読むだけ。書けるのは管理者だけ
    match /plans/{id} {
      allow read: if isAdmin() || isMember(id);
      allow write: if isAdmin();
      // 盛替え業者が「入れた」を付けたときの記録(logs)だけ足せる
      allow create, update: if isCrew() && request.resource.data.keys().hasOnly(['logs', 'at']);
    }
    // 追加注文: 業者が自分の分を出し、管理者が手配と上げた日を書き込む
    match /orders/{id} {
      allow read: if isAdmin() || isMember(id) || isCrew();
      allow write: if isAdmin() || (isMember(id) && isApproved());
      // 盛替え業者は、手配済みの注文に「入れた」を付けられる
      allow update: if isCrew() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items', 'at']);
    }

    // 業者から送る連絡: 利用中の業者は、連絡を1件ずつ足すことだけができる(last = 足した連絡のID、fv = 差出人の会社 = 自分の会社)
    function msgAdd() {
      let d = request.resource.data;
      let k = d.get('last', '');
      let me = get(/databases/$(database)/documents/approved/$(request.auth.uid)).data;
      return k is string && k.size() > 0 && k.size() <= 40
        && d.items is map && k in d.items
        && d.items[k].keys().hasOnly(['d', 'kind', 'msg', 'at', 'by', 'fv', 'fn'])
        && d.items[k].kind == 'msg' && d.items[k].fv == me.get('vid', request.auth.uid)
        && d.items[k].msg is string && d.items[k].msg.size() <= 300
        && (resource == null
            ? d.keys().hasOnly(['items', 'last']) && d.items.keys().hasOnly([k])
            : d.diff(resource.data).affectedKeys().hasOnly(['items', 'last'])
              && d.items.diff(resource.data.get('items', {})).affectedKeys().hasOnly([k])
              && !(k in resource.data.get('items', {})));
    }
    // 業者へのお知らせ: 管理者が出し、業者本人は「確認した」(ack)だけ書ける。ほかの業者は連絡を1件ずつ足せる
    match /notices/{id} {
      allow read: if isAdmin() || isMember(id);
      allow write: if isAdmin();
      allow update: if isMember(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ack']);
      allow create, update: if isApproved() && msgAdd();
    }
    // 業者から管理者・盛替え業者への連絡(admin・crew の2つだけ)。盛替え業者は「見ました」(ack)だけ書ける
    match /inbox/{id} {
      allow read: if isAdmin() || (id == 'crew' && isCrew());
      allow write: if isAdmin();
      allow update: if id == 'crew' && isCrew() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ack']);
      allow create, update: if id in ['admin', 'crew'] && isApproved() && msgAdd();
    }
    // 業者が送った連絡の控え: その会社のメンバーが書く。受け取った人は「見ました」(seen)だけ書ける
    match /sent/{id} {
      allow read: if isAdmin() || isMember(id);
      allow write: if isAdmin() || (isMember(id) && isApproved());
      allow update: if (isApproved() || isCrew()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']);
    }
    // 参加コード: コードを知っている人だけが1件ずつ読める(一覧は管理者だけ)。会社のメンバーと管理者が作る
    match /codes/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isAdmin() || (isApproved() && isMember(request.resource.data.vid)
        && request.resource.data.keys().hasOnly(['vid', 'company', 'at']));
      allow update, delete: if isAdmin();
    }

    // 盛替え業者の登録内容: 本人が出し、管理者が見る
    match /crewreq/{id} {
      allow read: if isAdmin() || isSelf(id);
      allow delete: if isAdmin();
      allow create, update: if isAdmin() || (isSelf(id)
        && request.resource.data.keys().hasOnly(['company', 'contact', 'email', 'at'])
        && request.resource.data.company is string && request.resource.data.company.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200);
    }
    // 盛替え業者の利用許可: 本人は申請と同時に自分の分を作れる(利用停止された人は作れない)。変更・削除は管理者だけ
    match /crews/{id} {
      allow read: if isAdmin() || isSelf(id);
      allow create: if isAdmin() || (isSelf(id)
        && !exists(/databases/$(database)/documents/crewblocked/$(id))
        && request.resource.data.keys().hasOnly(['company', 'email', 'at', 'name'])
        && request.resource.data.company is string && request.resource.data.company.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200);
      allow update, delete: if isAdmin();
    }
    // 盛替え業者の利用停止: 管理者だけが付け外しできる
    match /crewblocked/{id} {
      allow read: if isAdmin() || isSelf(id);
      allow write: if isAdmin();
    }
    // 最終ログイン: 本人が開いた時刻だけを書き、管理者が読む
    match /seen/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isSelf(id)
        && request.resource.data.keys().hasOnly(['at', 'email', 'kind'])
        && request.resource.data.at is string && request.resource.data.at.size() <= 40
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.kind in ['admin', 'vendor', 'crew'];
    }
    // プッシュ通知の登録: 本人が自分の端末を登録・削除する。送るのは GitHub Actions(サーバー)
    match /push/{id} {
      allow read, delete: if isSelf(id) || isAdmin();
      allow create, update: if isSelf(id)
        && request.resource.data.keys().hasOnly(['subs', 'kind', 'at'])
        && request.resource.data.subs is map && request.resource.data.subs.size() <= 10
        && request.resource.data.kind in ['admin', 'vendor', 'crew']
        && request.resource.data.at is string && request.resource.data.at.size() <= 40;
    }
    // メールの送信待ち: アプリが入れ、GitHub Actions(サーバー)が送って消す。業者・盛替え業者へのお知らせは管理者(と搬出確認の盛替え業者)だけが入れられる
    match /outbox/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['to', 'vid', 'd', 'msg', 'at', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 600
        && (isAdmin()
            || request.resource.data.to == 'admin'
            || request.resource.data.to == 'me'
            || (request.resource.data.to == 'vendor' && isCrew())
            || (request.resource.data.to in ['vendor', 'crew'] && isApproved()));
    }

    // ===== スクラップ搬出(scrap_ で始まるコレクション) =====
    function isApprovedScrap() {
      return signedIn() && exists(/databases/$(database)/documents/scrap_approved/$(request.auth.uid));
    }
    // 会社のメンバー: 会社IDが本人のID(最初に登録した人)か、利用許可(approved)に入っている会社ID(vid)と同じ
    function isMemberScrap(id) {
      return signedIn() && (request.auth.uid == id
        || (exists(/databases/$(database)/documents/scrap_approved/$(request.auth.uid))
            && get(/databases/$(database)/documents/scrap_approved/$(request.auth.uid)).data.get('vid', request.auth.uid) == id));
    }
    // 揚重(盛替え)業者: 申請して利用許可(crews)がある人。搬出予定を見て、搬出確認と戻しの✅だけ付けられる
    function isCrewScrap() {
      return signedIn() && exists(/databases/$(database)/documents/scrap_crews/$(request.auth.uid));
    }

    // 回収日・設定: 管理者・利用中の業者・盛替え業者が読む。書けるのは管理者だけ
    match /scrap_config/{id} {
      allow read: if isAdmin() || isApprovedScrap() || isCrewScrap();
      allow write: if isAdmin();
    }
    match /scrap_days/{id} {
      allow read: if isAdmin() || isApprovedScrap() || isCrewScrap();
      allow write: if isAdmin();
    }
    // 確定した回収: 行(rows)は管理者だけ。盛替え業者は行ごとの搬出確認・戻し(st)と履歴(hist)だけ書き換えられる
    match /scrap_confirmed/{id} {
      allow read: if isAdmin() || isApprovedScrap() || isCrewScrap();
      allow write: if isAdmin();
      allow update: if isCrewScrap() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'at', 'hist']);
    }

    // 業者の入力: 本人(利用中)と管理者。盛替え業者は戻したときの台数(floors)だけ書き換えられる
    match /scrap_vendors/{id} {
      allow read: if isAdmin() || isMemberScrap(id) || isCrewScrap();
      allow write: if isAdmin() || (isMemberScrap(id) && isApprovedScrap());
      allow update: if isCrewScrap() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['floors', 'updated']);
    }

    // 業者の登録内容: 本人が出し、管理者が見る
    match /scrap_members/{id} {
      allow read: if isAdmin() || isSelf(id);
      allow delete: if isAdmin();
      allow create, update: if isAdmin() || (isSelf(id)
        && request.resource.data.keys().hasOnly(['company', 'contact', 'email', 'at'])
        && request.resource.data.company is string && request.resource.data.company.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200);
    }

    // 利用許可: 業者は登録と同時に自分の分を作れる(利用停止された人は作れない)。変更・削除は管理者だけ(本人は参加コードでの会社の入り直しだけできる)
    // 会社ID(vid)は、新しい会社なら本人のID、参加コードで入るならそのコードの会社ID
    match /scrap_approved/{id} {
      allow read: if isAdmin() || isSelf(id);
      allow create: if isAdmin() || (isSelf(id)
        && !exists(/databases/$(database)/documents/scrap_blocked/$(id))
        && request.resource.data.keys().hasOnly(['company', 'email', 'at', 'vid', 'code', 'name'])
        && (request.resource.data.get('vid', id) == id
            || (request.resource.data.code is string
                && get(/databases/$(database)/documents/scrap_codes/$(request.resource.data.code)).data.vid == request.resource.data.vid))
        && request.resource.data.company is string && request.resource.data.company.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200);
      allow update, delete: if isAdmin();
      // 登録した後でも、参加コードで別の会社に入り直せる(会社ID・コード・会社名だけ。コードの会社IDと一致するときだけ)
      allow update: if isSelf(id)
        && !exists(/databases/$(database)/documents/scrap_blocked/$(id))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vid', 'code', 'company'])
        && request.resource.data.code is string
        && get(/databases/$(database)/documents/scrap_codes/$(request.resource.data.code)).data.vid == request.resource.data.vid
        && request.resource.data.company is string && request.resource.data.company.size() <= 100;
    }
    // 利用停止: 管理者だけが付け外しできる
    match /scrap_blocked/{id} {
      allow read: if isAdmin() || isSelf(id);
      allow write: if isAdmin();
    }
    // 追加した台数の記録: 会社のメンバーは読むだけ。書けるのは管理者だけ
    match /scrap_plans/{id} {
      allow read: if isAdmin() || isMemberScrap(id);
      allow write: if isAdmin();
      // 盛替え業者が「入れた」を付けたときの記録(logs)だけ足せる
      allow create, update: if isCrewScrap() && request.resource.data.keys().hasOnly(['logs', 'at']);
    }
    // 追加注文: 業者が自分の分を出し、管理者が手配と上げた日を書き込む
    match /scrap_orders/{id} {
      allow read: if isAdmin() || isMemberScrap(id) || isCrewScrap();
      allow write: if isAdmin() || (isMemberScrap(id) && isApprovedScrap());
      // 盛替え業者は、手配済みの注文に「入れた」を付けられる
      allow update: if isCrewScrap() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items', 'at']);
    }

    // 業者から送る連絡: 利用中の業者は、連絡を1件ずつ足すことだけができる(last = 足した連絡のID、fv = 差出人の会社 = 自分の会社)
    function msgAddScrap() {
      let d = request.resource.data;
      let k = d.get('last', '');
      let me = get(/databases/$(database)/documents/scrap_approved/$(request.auth.uid)).data;
      return k is string && k.size() > 0 && k.size() <= 40
        && d.items is map && k in d.items
        && d.items[k].keys().hasOnly(['d', 'kind', 'msg', 'at', 'by', 'fv', 'fn'])
        && d.items[k].kind == 'msg' && d.items[k].fv == me.get('vid', request.auth.uid)
        && d.items[k].msg is string && d.items[k].msg.size() <= 300
        && (resource == null
            ? d.keys().hasOnly(['items', 'last']) && d.items.keys().hasOnly([k])
            : d.diff(resource.data).affectedKeys().hasOnly(['items', 'last'])
              && d.items.diff(resource.data.get('items', {})).affectedKeys().hasOnly([k])
              && !(k in resource.data.get('items', {})));
    }
    // 業者へのお知らせ: 管理者が出し、業者本人は「確認した」(ack)だけ書ける。ほかの業者は連絡を1件ずつ足せる
    match /scrap_notices/{id} {
      allow read: if isAdmin() || isMemberScrap(id);
      allow write: if isAdmin();
      allow update: if isMemberScrap(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ack']);
      allow create, update: if isApprovedScrap() && msgAddScrap();
    }
    // 業者から管理者・盛替え業者への連絡(admin・crew の2つだけ)。盛替え業者は「見ました」(ack)だけ書ける
    match /scrap_inbox/{id} {
      allow read: if isAdmin() || (id == 'crew' && isCrewScrap());
      allow write: if isAdmin();
      allow update: if id == 'crew' && isCrewScrap() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ack']);
      allow create, update: if id in ['admin', 'crew'] && isApprovedScrap() && msgAddScrap();
    }
    // 業者が送った連絡の控え: その会社のメンバーが書く。受け取った人は「見ました」(seen)だけ書ける
    match /scrap_sent/{id} {
      allow read: if isAdmin() || isMemberScrap(id);
      allow write: if isAdmin() || (isMemberScrap(id) && isApprovedScrap());
      allow update: if (isApprovedScrap() || isCrewScrap()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']);
    }
    // 参加コード: コードを知っている人だけが1件ずつ読める(一覧は管理者だけ)。会社のメンバーと管理者が作る
    match /scrap_codes/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isAdmin() || (isApprovedScrap() && isMemberScrap(request.resource.data.vid)
        && request.resource.data.keys().hasOnly(['vid', 'company', 'at']));
      allow update, delete: if isAdmin();
    }

    // 盛替え業者の登録内容: 本人が出し、管理者が見る
    match /scrap_crewreq/{id} {
      allow read: if isAdmin() || isSelf(id);
      allow delete: if isAdmin();
      allow create, update: if isAdmin() || (isSelf(id)
        && request.resource.data.keys().hasOnly(['company', 'contact', 'email', 'at'])
        && request.resource.data.company is string && request.resource.data.company.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200);
    }
    // 盛替え業者の利用許可: 本人は申請と同時に自分の分を作れる(利用停止された人は作れない)。変更・削除は管理者だけ
    match /scrap_crews/{id} {
      allow read: if isAdmin() || isSelf(id);
      allow create: if isAdmin() || (isSelf(id)
        && !exists(/databases/$(database)/documents/scrap_crewblocked/$(id))
        && request.resource.data.keys().hasOnly(['company', 'email', 'at', 'name'])
        && request.resource.data.company is string && request.resource.data.company.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200);
      allow update, delete: if isAdmin();
    }
    // 盛替え業者の利用停止: 管理者だけが付け外しできる
    match /scrap_crewblocked/{id} {
      allow read: if isAdmin() || isSelf(id);
      allow write: if isAdmin();
    }
    // 最終ログイン: 本人が開いた時刻だけを書き、管理者が読む
    match /scrap_seen/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isSelf(id)
        && request.resource.data.keys().hasOnly(['at', 'email', 'kind'])
        && request.resource.data.at is string && request.resource.data.at.size() <= 40
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.kind in ['admin', 'vendor', 'crew'];
    }
    // プッシュ通知の登録: 本人が自分の端末を登録・削除する。送るのは GitHub Actions(サーバー)
    match /scrap_push/{id} {
      allow read, delete: if isSelf(id) || isAdmin();
      allow create, update: if isSelf(id)
        && request.resource.data.keys().hasOnly(['subs', 'kind', 'at'])
        && request.resource.data.subs is map && request.resource.data.subs.size() <= 10
        && request.resource.data.kind in ['admin', 'vendor', 'crew']
        && request.resource.data.at is string && request.resource.data.at.size() <= 40;
    }
    // メールの送信待ち: アプリが入れ、GitHub Actions(サーバー)が送って消す。業者・盛替え業者へのお知らせは管理者(と搬出確認の盛替え業者)だけが入れられる
    match /scrap_outbox/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['to', 'vid', 'd', 'msg', 'at', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 600
        && (isAdmin()
            || request.resource.data.to == 'admin'
            || request.resource.data.to == 'me'
            || (request.resource.data.to == 'vendor' && isCrewScrap())
            || (request.resource.data.to in ['vendor', 'crew'] && isApprovedScrap()));
    }
  }
}
